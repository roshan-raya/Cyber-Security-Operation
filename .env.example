# Copy to .env and set values. Never commit .env.
#
# Required (must be set):
#   GF_SECURITY_ADMIN_USER     - Grafana admin username (e.g. admin)
#   GF_SECURITY_ADMIN_PASSWORD - Grafana admin password (use a strong value)
#
# Optional: override defaults below. Admin creds are only set via env (no hardcoding).

# Grafana admin (required for provisioning and login)
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=Nepsoft@123!

# Secure-by-default Grafana settings (recommended to keep)
GF_USERS_ALLOW_SIGN_UP=false
GF_AUTH_ANONYMOUS_ENABLED=false

# Optional: override defaults
# PROMETHEUS_PORT=9090
# GRAFANA_PORT=3000
# TheHive
THEHIVE_ADMIN_EMAIL=admin@catnipgames.com
THEHIVE_ADMIN_PASSWORD=Nepsoft@321!
THEHIVE_ADMIN_FIRSTNAME=SOC
THEHIVE_ADMIN_LASTNAME=Admin
THEHIVE_ORG_NAME=CatnipGamesSOC
THEHIVE_ORG_DESCRIPTION="Catnip Games International Security Operations Centre"

# MISP (keep MISP_ADMIN_PASSWORD identical to the MISP web UI / DB; min ~12 chars. After copy, run: make misp-init)
MISP_ADMIN_EMAIL=admin@catnipgames.com
MISP_ADMIN_PASSWORD=Nepsoft@321!
MISP_MYSQL_ROOT_PASSWORD=misproot
MISP_MYSQL_PASSWORD=misppassword
MISP_BASEURL=http://localhost:8080
MISP_ORG=CatnipGamesSOC

# MISP-TheHive integration: 40-character MISP REST authkey for servers/add (not TheHive Bearer token).
# make misp-init mints a key to .misp_auth_key; you can copy it here or leave empty to use the file.
MISP_THEHIVE_API_KEY=

# Cortex
CORTEX_ADMIN_PASSWORD=Nepsoft@123
CORTEX_API_KEY=
CORTEX_URL=http://localhost:9001

# Python automation
ALERT_INGESTOR_INTERVAL=60
KPI_REPORT_INTERVAL=300

