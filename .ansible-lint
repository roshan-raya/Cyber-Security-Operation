# What this file is: the “house rules” ansible-lint uses when CI runs `ansible-lint ansible/`
# (see .github/workflows/ci.yml). It does not change how playbooks run — only what fails the build.
#
# How it connects elsewhere:
#   - ansible/ansible.cfg sets roles_path for the container layout; locally/CI we also export
#     ANSIBLE_ROLES_PATH so `ansible-playbook --syntax-check` resolves roles the same way.
#   - When you tighten skip_list entries, expect CI to start failing until playbooks/roles match.
---
skip_list:
  - var-naming
  - yaml[line-length]
  - yaml[truthy]
  - risky-file-permissions
  - command-instead-of-shell
  - risky-shell-pipe
  - name[play]
  # Playbook uses strategy: free for concurrent patching; run-once flags that pattern.
  - run-once
