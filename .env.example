# NOTE: Sensitive values like Grafana passwords are now managed via Ansible Vault.
# See ansible/vault/README.md for setup instructions.
# The values below are for Docker Compose only (non-sensitive defaults).

GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=Nepsoft@123
GF_USERS_ALLOW_SIGN_UP=false
GF_AUTH_ANONYMOUS_ENABLED=false
# Alertmanager webhook for critical alerts. Use https://webhook.site for demos.
ALERTMANAGER_WEBHOOK_URL=https://webhook.site/YOUR-UUID-HERE
